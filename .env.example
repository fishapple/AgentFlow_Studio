# AgentFlow Studio Environment Configuration
# Copy this file to .env and customize for your environment

# Application
APP_NAME="AgentFlow Studio"
APP_VERSION="0.1.0-alpha"
DEBUG=true

# Database (PostgreSQL)
DATABASE_URL="postgresql://agentflow:secret@localhost/agentflow_db"
POSTGRES_USER="agentflow"
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=agentflow_db

# Redis Cache & Queue
REDIS_URL="redis://localhost:6379/0"

# API Configuration
API_V1_PREFIX="/api/v1"

# Security (CHANGE THESE IN PRODUCTION!)
SECRET_KEY=change-this-in-production-use-secure-random-key
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Settings
CORS_ORIGINS="http://localhost:5173,http://localhost:8000"

# Frontend Vite (used in vite.config.ts)
VITE_API_URL=http://localhost:8000/api/v1

