# AgentFlow Studio - Environment Configuration Template
# Copy this file to .env and fill in your actual values

# ===========================================
# DATABASE CONFIGURATION (PostgreSQL)
# ===========================================
DATABASE_URL=postgresql://user:password@localhost:5432/agentflow_db

# ===========================================
# REDIS CONFIGURATION (for caching & queues)
# ===========================================
REDIS_URL=redis://localhost:6379/0

# ===========================================
# API SECURITY
# ===========================================
SECRET_KEY=change-this-to-a-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ===========================================
# OPENAI API CONFIGURATION
# ===========================================
OPENAI_API_KEY=sk-your-openai-api-key-here  # Get from https://platform.openai.com/api-keys
OPENAI_ORG_ID=your-org-id-if-using-teams    # Optional: leave blank for personal account

# Supported models: gpt-4-turbo, gpt-3.5-turbo
DEFAULT_MODEL=gpt-4-turbo

# ===========================================
# ANTHROPIC API CONFIGURATION (Claude)
# ===========================================
ANTHROPIC_API_KEY=your-anthropic-api-key-here  # Get from https://console.anthropic.com/
DEFAULT_ANTHROPIC_MODEL=claude-3-opus-20240229

# ===========================================
# GOOGLE GEMINI API CONFIGURATION
# ===========================================
GOOGLE_API_KEY=your-google-gemini-api-key-here  # Get from https://aistudio.google.com/
DEFAULT_GEMINI_MODEL=gemini-pro

# ===========================================
# APPLICATION SETTINGS
# ===========================================
DEBUG=True                          # Set to False in production
ENVIRONMENT=development             # development, staging, production

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://localhost:3000  # Comma-separated allowed origins

# Rate Limiting (requests per minute)
RATE_LIMIT_PER_MINUTE=60

# ===========================================
# LOGGING CONFIGURATION
# ===========================================
LOG_LEVEL=DEBUG                     # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FORMAT=json                     # json or text in production

# ===========================================
# MONITORING & TELEMETRY (Optional)
# ===========================================
ENABLE_METRICS=True                 # Enable Prometheus metrics endpoint
METRICS_PORT=9090                   # Port for /metrics endpoint

SENTRY_DSN=""                       # Set to your Sentry DSN for error tracking
NEW_RELIC_LICENSE_KEY=""            # Set to your New Relic license key

# ===========================================
# DOCKER & DEPLOYMENT (Optional)
# ===========================================
DOCKER_REGISTRY_URL=docker.io/fishapple/agentflow
IMAGE_TAG=latest
